APP_NAME=RenderKit
APP_URL=https://api.example.com
DOMAIN=api.example.com
PORT=3000
SESSION_SECRET=replace-with-64-random-hex-chars
RENDER_CONCURRENCY=4
RENDER_TIMEOUT_MS=30000
FREE_TOOL_PER_HOUR=10
# Billing provider: paddle (merchant of record, sellers from any non-sanctioned country) or stripe
BILLING_PROVIDER=paddle

# Paddle Billing (paddle.com → Developer tools). Use PADDLE_ENV=sandbox with sandbox keys while testing.
PADDLE_ENV=production
PADDLE_API_KEY=pdl_live_apikey_...
PADDLE_CLIENT_TOKEN=live_...
PADDLE_WEBHOOK_SECRET=pdl_ntfset_...
PADDLE_PRICE_STARTER=pri_...
PADDLE_PRICE_PRO=pri_...
PADDLE_PRICE_BUSINESS=pri_...

# Stripe, only if BILLING_PROVIDER=stripe (needs a business in a Stripe-supported country)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
# Local development only: point at a Chromium binary if not using the Docker image
# CHROMIUM_PATH=/opt/pw-browsers/chromium
# ALLOW_PRIVATE_NETWORK=1
