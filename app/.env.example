APP_NAME=RenderKit
APP_URL=https://api.example.ru
DOMAIN=api.example.ru
PORT=3000
SESSION_SECRET=replace-with-64-random-hex-chars
RENDER_CONCURRENCY=4
RENDER_TIMEOUT_MS=30000
FREE_TOOL_PER_HOUR=10

# Market: RUB prices and Russian UI (CURRENCY=USD SITE_LANG=en for the English version)
CURRENCY=RUB
SITE_LANG=ru

# Реквизиты продавца: показываются в подвале, оферте и политике (нужны для модерации ЮKassa)
LEGAL_NAME=ИП Иванов Иван Иванович
LEGAL_INN=000000000000
LEGAL_OGRN=000000000000000
LEGAL_EMAIL=support@example.ru
LEGAL_ADDRESS=

# Биллинг: yookassa (РФ), paddle (нерезиденты вне санкционного списка), stripe, none
BILLING_PROVIDER=yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_SEND_RECEIPT=1     # чеки 54-ФЗ через ЮKassa (нужна подключённая онлайн-касса или режим самозанятого)
YOOKASSA_VAT_CODE=1         # 1 = без НДС (УСН/НПД), 2 = 0%, 3 = 10%, 4 = 20%
YOOKASSA_AUTOPAY=1          # автопродление с сохранённой карты (включите «автоплатежи» в личном кабинете ЮKassa)
BILLING_GRACE_DAYS=3

# Paddle, only if BILLING_PROVIDER=paddle
PADDLE_ENV=production
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_STARTER=
PADDLE_PRICE_PRO=
PADDLE_PRICE_BUSINESS=

# Stripe, only if BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Local development only
# CHROMIUM_PATH=/opt/pw-browsers/chromium
# ALLOW_PRIVATE_NETWORK=1
