{
  "manifest_version": 3,
  "name": "SiteSweep: Accessibility, Broken Links & SEO Audit",
  "short_name": "SiteSweep",
  "version": "1.0.0",
  "description": "Crawl the site you are on and get an accessibility (WCAG via axe-core), broken-link and SEO audit. Works behind login. Export client-ready reports.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SiteSweep: audit this site"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "activeTab"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://extensionpay.com/*"],
      "js": ["ExtPay.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": []
}
